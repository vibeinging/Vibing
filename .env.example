# Vibing Environment Configuration
# Copy this file to .env and fill in the values before starting.
#
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control.

# ----- Required -----

# Secret key for JWT authentication. MUST be set in production.
# Generate with: openssl rand -hex 32
VIBING_AUTH_SECRET=change-me-to-a-random-secret

# ----- Optional -----

# Relay server listen address
# VIBING_RELAY_BIND=0.0.0.0:8766

# Terminal server listen address
# VIBING_SERVER_BIND=0.0.0.0:8765

# Log level: trace, debug, info, warn, error
# VIBING_LOG_LEVEL=info
